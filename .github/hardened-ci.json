{
  "image": "nginx-waf-hardened",
  "version": {
    "key": "nginx"
  },
  "revision": [
    "--unanchored",
    "--",
    "Dockerfile",
    "conf/",
    "errors/",
    "init.go",
    "go.mod",
    "keys/",
    "versions.json"
  ],
  "platforms": [
    "linux/amd64",
    "linux/arm64"
  ],
  "compose_service": "nginx",
  "probes": [
    {
      "label": "nginx",
      "want": "version",
      "cmd": "docker exec nginx-waf nginx -v",
      "regex": "nginx/\\K[0-9][0-9.]*"
    }
  ],
  "smoke": "./scripts/test.sh 127.0.0.1 80"
}
